# Скопируйте этот файл в .env и заполните свои значения.
# cp .env.example .env   (PowerShell: Copy-Item .env.example .env)

# Токен бота, полученный у @BotFather в Telegram.
# Нужен только для режима бота; локальная команда process работает и без него.
TELEGRAM_BOT_TOKEN=

# --- Лимиты ---
# Максимальный размер входного файла, МБ. Bot API не даёт скачивать > 20 МБ.
MAX_INPUT_SIZE_MB=19
# Максимальный размер отправляемого результата, МБ (лимит Bot API — 50 МБ).
MAX_SEND_SIZE_MB=50
# Максимальная длительность видео, секунды (0 = без ограничения).
MAX_DURATION_SEC=600

# --- Размытие ---
# Режим: normal (умеренно сильное) | strong (сильное, по умолчанию) | pixelate
BLUR_MODE=strong
# Сила размытия, множитель (0.5 слабее, 2.0 сильнее).
BLUR_STRENGTH=1.0
# Запас вокруг bounding box лица (доля стороны).
FACE_PADDING=0.30

# --- Детекция лиц (YuNet) ---
# Максимальная длинная сторона кадра для основного прохода детекции.
# Меньше = быстрее; 640-1280 разумные значения.
DET_MAX_SIDE=960
# Дополнительные масштабы детекции (относительно DET_MAX_SIDE).
DET_SCALES=1.0,0.5
# Порог уверенности детектора (ниже = больше находим, больше ложных срабатываний).
DET_SCORE_THRESHOLD=0.6
DET_NMS_THRESHOLD=0.3
# Порог IoU для объединения дублей между проходами.
DET_NMS_IOU=0.35
# Путь к модели (можно указать свой).
MODEL_PATH=models/face_yunet_2023mar.onnx

# --- Кодирование видео ---
# auto | nvenc (GPU, H.264 через видеокарту) | x264 (CPU)
ENCODER=auto
# Качество GPU-кодирования (CQ; меньше = лучше).
NVENC_CQ=23
# Качество CPU-кодирования (CRF; меньше = лучше, 18 визуально близко к исходному).
X264_CRF=18
# Фиксированный битрейт вместо режима качества (например 8M). Пусто = качество.
VIDEO_BITRATE=
# Полная проверка декодируемости результата для видео короче N секунд (0 = выкл).
VERIFY_MAX_DURATION_SEC=300

# --- Служебные ---
# Каталог временных файлов.
TEMP_DIR=tmp
# Не удалять временные файлы (отладка).
KEEP_TEMP=0
# Сколько заданий обрабатывать одновременно.
MAX_PARALLEL_JOBS=1
# Как часто обновлять прогресс в Telegram, секунды.
PROGRESS_INTERVAL_SEC=3
# Явные пути к ffmpeg/ffprobe (пусто = bundled tools/bin или PATH).
FFMPEG_PATH=
FFPROBE_PATH=

# --- Локальный Bot API сервер (docker-compose.yml) ---
# Пусто = облачный api.telegram.org (лимиты 20/50 МБ). Чтобы принимать
# оригиналы до ~2 ГБ: 1) заполните TELEGRAM_API_ID/HASH ниже, 2) docker compose up -d,
# 3) один раз: python tools/local_api.py logout, 4) раскомментируйте строку ниже,
# 5) перезапустите бота. Лимиты 19/50 МБ при этом поднимутся автоматически (до 1900 МБ).
# TELEGRAM_API_BASE=http://localhost:8081
# Каталог данных сервера со стороны бота (запасной способ чтения файлов).
TELEGRAM_LOCAL_FILES_DIR=tg-api-data
# Префикс путей файлов на диске сервера (как в file_path ответа getFile).
TELEGRAM_SERVER_FILES_PREFIX=/var/lib/telegram-bot-api

# Ключи для docker compose (получить: https://my.telegram.org -> API development tools)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
